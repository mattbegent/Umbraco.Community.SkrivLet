{
    "propertyEditors": [
        {
            "alias": "skrivLet",
            "name": "SkrivLet",
            "icon": "icon-notepad",
            "group": "Rich Content",
            "editor": {
                "view": "~/App_Plugins/SkrivLet/skrivlet.html",
                "supportsReadOnly": true,
                "hideLabel": true,
                "valueType": "JSON"
            },
            "prevalues": {
                "fields": [
                    {
                        "label": "Placeholder",
                        "description": "The placeholder for empty text.",
                        "key": "placeholder",
                        "view": "textstring"
                    },
                    {
                        "label": "Enable Fullscreen",
                        "description": "Enable ability for users to write in a full screen mode.",
                        "key": "enableFullscreen",
                        "view": "boolean"
                    },
                    {
                        "label": "Enable Document Recovery",
                        "description": "If enabled when a the user leaves the page without saving to Umbraco and comes back they will be prompted if they want to recover their document.",
                        "key": "enableRecoverDocument",
                        "view": "boolean"
                    },
                    {
                        "label": "Enable Debug",
                        "description": "Enable debug mode to display a JSON object of the data underneath SkrivLet.",
                        "key": "enableDebug",
                        "view": "boolean"
                    }
                ]
            },
            "defaultConfig": {
                "placeholder": "Type '/' to insert a block or just start typing something super...",
                "enableFullscreen": "1",
                "enableRecoverDocument": "1",
                "enableDebug": "0"
            }
        }
    ],
    "css": [
        "~/App_Plugins/SkrivLet/skrivlet.css"
    ],
    "javascript": [
        "~/App_Plugins/SkrivLet/editorjs-all.js",
        "~/App_Plugins/SkrivLet/skrivlet.controller.js"
    ],
    "bundleOptions": "None"
}
